# Host Configuration for Uptime Monitor
# Copy to hosts.yaml and customize
# SSH keys referenced by key_path should be placed in /config/keys/ (mounted volume)

hosts:
  # Example: SSH host with psutil (preferred - richest metrics)
  - name: web-01
    connection: ssh
    endpoint: 10.0.0.5
    port: 22
    user: monitor
    key_path: /keys/web-01
    sudo: false
    timeout: 10s
    proxy_jump: ""
    tags: [web, prod]
    # collector_preference: ""  # Optional: force "psutil" | "procfs" | "snmp" | "tailscale" | "custom"

  # Example: SNMP-capable network device (switch/router/firewall)
  - name: core-switch
    connection: snmp        # polled via gosnmp; port defaults to 161
    endpoint: 10.0.0.254
    port: 161
    snmp_version: "2c"      # "2c" (community) or "3" (user-based)
    snmp_community: public
    # v3 alternative:
    # snmp_v3_user: monitor
    # snmp_v3_auth_proto: SHA        # MD5 | SHA | SHA256 | SHA512
    # snmp_v3_auth_pass: secret
    # snmp_v3_priv_proto: AES        # DES | AES | AES192 | AES256
    # snmp_v3_priv_pass: secret
    snmp_extra_oids: |       # optional extra OIDs -> snmp.custom.<metric>
      1.3.6.1.4.1.9.9.109.1.1.1.1.7.1 cpm_cpu_pct
    tags: [network]

  # Example: SSH host without Python/psutil (falls back to /proc + df)
  - name: legacy-db
    connection: ssh
    endpoint: 10.0.0.10
    port: 22
    user: monitor
    key_path: /keys/legacy-db
    sudo: true          # Required for df on some systems
    timeout: 15s
    proxy_jump: bastion.example.com
    tags: [db, prod]

  # Example: Host reachable only via Tailscale
  - name: remote-edge
    connection: tailscale
    endpoint: 100.64.1.42    # Tailscale IP (100.x.y.z)
    port: 22
    user: monitor
    key_path: /keys/remote-edge
    sudo: false
    timeout: 20s
    tags: [edge, iot]

  # Example: Host behind SSH bastion/proxy jump
  - name: private-api
    connection: ssh
    endpoint: 10.10.0.5
    port: 22
    user: monitor
    key_path: /keys/private-api
    sudo: false
    timeout: 10s
    proxy_jump: monitor@bastion.example.com:22
    tags: [api, internal]

# Key Management:
# 1. Generate keys: ssh-keygen -t ed25519 -f config/keys/web-01 -C "uptime-monitor@web-01"
# 2. Copy public key to target host: ssh-copy-id -i config/keys/web-01.pub monitor@10.0.0.5
# 3. Ensure private key permissions: chmod 600 config/keys/web-01
# 4. Mount config/ directory as /config in container (read-only recommended)